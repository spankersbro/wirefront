{
  "name": "wirefront",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:rules": "firebase emulators:exec --only database,firestore --project demo-wirefront 'node --test tests/rules/*.test.js'",
    "lint": "eslint js && prettier --check js css",
    "format": "prettier --write js css"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.0",
    "eslint": "10.15.0",
    "firebase": "13.3.0",
    "firebase-tools": "15.36.0",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}
