{
  "rules": {
    "rooms": {
      "global": {
        "players": {
          ".read": true,
          "$playerId": {
            ".write": "auth != null && ($playerId.beginsWith(auth.uid + '_') || (!newData.exists() && data.child('t').val() < now - 15000))",
            ".validate": "newData.hasChildren(['name','x','z','yaw','t'])",
            "name": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3,8} [A-Z]{3,8}$/)" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000" },
            "z": { ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000" },
            "yaw": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100" },
            "t": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
